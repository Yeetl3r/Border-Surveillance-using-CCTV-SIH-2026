# Model weights -- fetched once via scripts/fetch_weights.py (F15).
# `weights/*` rather than `weights/`, because git cannot re-include a file
# whose parent directory is excluded, and the two trained detectors below have
# to travel with the repo: they are the output of a GPU training run against
# specific datasets, not something a fresh clone can fetch from upstream.
*.pt
*.pth
*.safetensors
weights/*
# Last matching pattern wins, so these two survive the *.pt rule above.
!weights/weapons_yolo26n.pt
!weights/drones_yolo26n.pt

# Runtime data: alert log, evidence, clips, relay payloads, gallery
data/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.claude/
.vscode/*
!.vscode/launch.json

# Training data and runs -- fetched with scripts/fetch_datasets.py, gigabytes
datasets/
runs/